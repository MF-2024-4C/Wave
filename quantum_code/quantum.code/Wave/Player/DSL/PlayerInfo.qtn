asset PlayerConfig;

component PlayerSys
{
    asset_ref<PlayerConfig> Config;
    
    [HideInInspector] byte PlayerAnimState;
    [HideInInspector] FPQuaternion TargetRotation;    
    
    [HideInInspector] FP WalkSpeed;
    [HideInInspector] FP RunSpeed;
    [HideInInspector] FP JumpPower;
    [HideInInspector] FP AirMovePower;
    
    [HideInInspector] FPVector3 CameraForwardDirection;
    [HideInInspector] EntityRef InteractEntity;
    
    [HideInInspector] bool IsDead;
    
    FPVector3 InteractRayOffset;
    FP InteractRayDistance;
    LayerMask InteractLayer;
}

event PlayerSpawnEvent{
    PlayerLink PlayerLink;
    EntityRef EntityRef;
}

event PlayerDownEvent{
    PlayerLink PlayerLink;
}

event PlayerReviveEvent{
    PlayerLink PlayerLink;
}