asset PlayerConfig;

component PlayerSys
{
    asset_ref<PlayerConfig> Config;
    
    byte PlayerAnimState;
    FPQuaternion TargetRotation;    
    
    FP WalkSpeed;
    FP RunSpeed;
    FP JumpPower;
    FP AirMovePower;
    
    FPVector3 CameraForwardDirection;
    EntityRef InteractEntity;
}

event PlayerSpawnEvent{
    PlayerLink PlayerLink;
    EntityRef EntityRef;
}